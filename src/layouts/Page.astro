---
import "katex/dist/katex.min.css";
import "./page.css";
import { statusLabels, type Status } from "../statuses";

interface Props {
  title: string;
  description: string;
  status: Status;
}

const { title, description, status } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} – GetMath`}</title>
    <meta name="description" content={description} />
    {/* A robots file has no effect below the domain root, so each page asks. */}
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <noscript>
      <style is:inline>
        .interaction { display: none !important; }
        .still { display: block !important; }
      </style>
    </noscript>
  </head>
  <body>
    <header>
      <a href={base}>GetMath</a>
      <p class="status">{statusLabels[status]}</p>
    </header>
    <main>
      <h1>{title}</h1>
      <slot />
    </main>
    <footer>
      <a href={`${base}third-party-licences.txt`}>Third-party licences</a>
    </footer>
  </body>
</html>
